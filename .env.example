# Copie este arquivo para `.env` e ajuste os valores. O `.env` esta gitignored.
#
# Os candidatos lidos pelo http-api (em ordem):
#   1. <raiz-do-monorepo>/.env  (este arquivo, recomendado)
#   2. packages/http-api/.env
#   3. cwd()/.env

# ── Autenticacao ──────────────────────────────────────────────────────────
# Token que TODO request precisa enviar via header X-Internal-Token.
# Em producao use um secret forte (32+ chars, gerado por openssl rand -hex 32).
INTERNAL_TOKEN=dev-secret-local-12345

# ── HTTP server ───────────────────────────────────────────────────────────
HTTP_API_HOST=127.0.0.1
HTTP_API_PORT=3002

# ── Logging ───────────────────────────────────────────────────────────────
# Niveis: debug | info | warn | error
LOG_LEVEL=debug

# true = loga o XML SOAP request/response (sanitizado, sem CSC nem cert).
# Util em dev pra inspecionar payloads SEFAZ. Em producao deixe false ou warn.
LOG_XML=true

# ── TLS / SEFAZ ───────────────────────────────────────────────────────────
# *** APENAS EM DEV ***
# Node 20 nao tem a cadeia ICP-Brasil no truststore. Sem isso, SEFAZ rejeita
# com "unable to get local issuer certificate". Em DEV pode desabilitar a
# verificacao da cadeia TLS aqui. Em PROD use NODE_EXTRA_CA_CERTS apontando
# para o bundle ICP-Brasil (ex.: /etc/ssl/certs/icp-brasil-bundle.pem).
NFE_API_INSECURE_TLS=true
