{
  "name": "acbr-node",
  "private": true,
  "description": "ACBr port to Node.js - Brazilian fiscal document library",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "start": "node packages/http-api/dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "ACBR_INTEGRATION=true vitest run --project integration",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "typecheck": "turbo typecheck",
    "check:asany": "node scripts/check-as-any.mjs",
    "baseline:asany": "node scripts/check-as-any.mjs --update",
    "check:tsc": "node scripts/check-tsc-baseline.mjs",
    "baseline:tsc": "node scripts/check-tsc-baseline.mjs --update",
    "check:routes": "node scripts/check-routes.mjs",
    "check:auth": "node scripts/check-auth.mjs",
    "validate": "pnpm typecheck && pnpm lint && pnpm check:asany && pnpm check:tsc && pnpm check:routes && pnpm check:auth && pnpm test && pnpm build",
    "prepare": "husky",
    "clean": "turbo clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "@eslint/js": "^9.18.0",
    "@types/node": "^25.6.0",
    "eslint": "^9.18.0",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.1",
    "turbo": "^2.3.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.20.0",
    "vitest": "^2.1.0"
  },
  "lint-staged": {
    "*.{ts,mjs,js}": [
      "eslint --fix --max-warnings 0"
    ]
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0"
  }
}
