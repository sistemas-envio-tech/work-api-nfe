{
  "name": "acbr-node",
  "private": true,
  "description": "ACBr port to Node.js - Brazilian fiscal document library",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "ACBR_INTEGRATION=true vitest run --project integration",
    "lint": "turbo lint",
    "clean": "turbo clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.0",
    "turbo": "^2.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0"
  }
}
