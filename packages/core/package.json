{
  "name": "@acbr-node/core",
  "version": "0.1.0",
  "description": "Core utilities for acbr-node: certificates, XML, SOAP, SEFAZ URLs",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "fast-xml-parser": "^4.5.0",
    "node-forge": "^1.4.0",
    "xml-crypto": "^6.0.0",
    "xmlbuilder2": "^3.1.1"
  },
  "peerDependencies": {
    "undici": ">=6.0.0"
  },
  "peerDependenciesMeta": {
    "undici": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node-forge": "^1.3.14",
    "typescript": "^5.6.0",
    "undici": "^7.0.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "license": "MIT"
}
